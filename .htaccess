DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    RewriteRule ^(?:config(?:\.local)?\.php|database\.(?:db|sql)|\.env|\.DS_Store)$ - [F,L]
    RewriteRule ^(?:scraper|scratch)(?:/|$) - [F,L]
</IfModule>

<FilesMatch "^(config(\.local)?\.php|database\.(db|sql)|\.env|\.DS_Store|package(-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
